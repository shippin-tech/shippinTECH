# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS portal
WORKDIR /src
COPY ui/package.json ui/package-lock.json ui/
COPY resources/schema/schema.json.gz resources/schema/schema.json.gz
RUN cd ui && npm ci
COPY ui/ ui/
COPY assets/webui/assets/*.woff2 assets/webui/assets/
COPY deploy/control-plan.template.json deploy/control-plan.template.json
RUN cd ui && npm run build

FROM debian:trixie-slim AS chef
ARG TARGETARCH
# Match the bundled server in deploy/compose.yaml.
ARG FDB_VERSION="7.4.6"
RUN apt-get update && \
    export DEBIAN_FRONTEND=noninteractive && \
    apt-get install -yq --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    clang \
    curl \
    jq \
    protobuf-compiler
ENV RUSTUP_HOME=/opt/rust/rustup \
    PATH=/home/root/.cargo/bin:/opt/rust/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN curl https://sh.rustup.rs -sSf | \
    env CARGO_HOME=/opt/rust/cargo \
    sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path && \
    env CARGO_HOME=/opt/rust/cargo \
    rustup component add rustfmt
RUN \
    ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    case "$ARCH" in \
        amd64) FDB_ARCH=amd64 ;; \
        arm64) FDB_ARCH=aarch64 ;; \
        *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac && \
    FDB_DEB="foundationdb-clients_${FDB_VERSION}-1_${FDB_ARCH}.deb" && \
    FDB_URL="https://github.com/apple/foundationdb/releases/download/${FDB_VERSION}/${FDB_DEB}" && \
    curl --retry 5 -fLsS -o "$FDB_DEB" "$FDB_URL" && \
    curl --retry 5 -fLsS -o "$FDB_DEB.sha256" "$FDB_URL.sha256" && \
    sha256sum -c "$FDB_DEB.sha256" && \
    mkdir -p /fdb && \
    dpkg -x "$FDB_DEB" /fdb && \
    mv /fdb/usr/include/foundationdb /usr/include && \
    mv /fdb/usr/lib/libfdb_c.so /usr/lib && \
    rm -rf "$FDB_DEB" "$FDB_DEB.sha256" /fdb
RUN env CARGO_HOME=/opt/rust/cargo cargo install cargo-chef && \
    rm -rf /opt/rust/cargo/registry/
WORKDIR /app

FROM chef AS planner
COPY Cargo.toml .
COPY Cargo.lock .
COPY crates/ crates/
COPY resources/ resources/
COPY tests/ tests/
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release -p shippin-tech --no-default-features --features "scale,postgres,enterprise" --recipe-path recipe.json
COPY Cargo.toml .
COPY Cargo.lock .
COPY crates/ crates/
COPY resources/ resources/
COPY tests/ tests/
RUN cargo build --locked -p shippin-tech --no-default-features --features "scale,postgres,enterprise" --release

FROM debian:trixie-slim AS runtime

COPY --from=builder --chmod=0755 /app/target/release/shippin-tech /usr/local/bin/shippin.tech
COPY --from=builder /usr/lib/libfdb_c.so /usr/lib/libfdb_c.so
RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update && \
    apt-get install -yq --no-install-recommends ca-certificates curl libcap2-bin && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -r -g 2000 shippin.tech && \
    useradd -r -u 2000 -g 2000 -s /usr/sbin/nologin -M shippin.tech && \
    mkdir -p /etc/shippin.tech /var/lib/shippin.tech /var/log/shippin.tech && \
    chown shippin.tech:shippin.tech /etc/shippin.tech /var/lib/shippin.tech /var/log/shippin.tech && \
    setcap 'cap_net_bind_service=+ep' /usr/local/bin/shippin.tech
COPY --from=portal --chown=shippin.tech:shippin.tech /src/ui/build /usr/share/shippin.tech/portal
# The host-side deploy scripts ride along so auto-update.sh can refresh them from the image.
COPY deploy/compose.yaml deploy/backend.sh deploy/update.sh deploy/auto-update.sh deploy/verify-install.sh \
     deploy/backup.sh deploy/host.sh deploy/relay.sh deploy/relay.py deploy/relay.env.example \
     deploy/server.env.example deploy/README.md deploy/PRODUCTION.md \
     /usr/share/shippin.tech/deploy/

USER shippin.tech
WORKDIR /var/lib/shippin.tech
VOLUME ["/etc/shippin.tech", "/var/lib/shippin.tech"]
EXPOSE	443 25 110 587 465 143 993 995 4190 8080
ENV shippin.tech_HEALTHCHECK_URL=https://127.0.0.1:443/healthz/live
ENV shippin.tech_PORTAL_DIR=/usr/share/shippin.tech/portal
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsSk -H "X-Forwarded-For: 127.0.0.1" "$(printenv shippin.tech_HEALTHCHECK_URL)" || curl -fsS -H "X-Forwarded-For: 127.0.0.1" http://127.0.0.1:8080/healthz/live || exit 1
ENTRYPOINT ["/usr/local/bin/shippin.tech"]
CMD ["--config", "/etc/shippin.tech/config.json"]
